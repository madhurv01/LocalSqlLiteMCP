# ---------------------------------------------------------------------------
# LocalDB Agent configuration. Copy to .env and adjust.
# The app works with ZERO configuration using the built-in heuristic planner.
# ---------------------------------------------------------------------------

# Directory where app metadata + snapshots are stored.
LOCALDB_DATA_DIR=./data

# App metadata database (Drizzle). Defaults to $LOCALDB_DATA_DIR/app.db
# APP_DB_PATH=./data/app.db

# Root directory that user .db/.sqlite files may be opened from.
# Path traversal outside this root is rejected. Defaults to ./databases
LOCALDB_DB_ROOT=./databases

# ---------------------------------------------------------------------------
# LLM provider for the planning step.
#   heuristic  -> free, offline, rule-based (default, no key needed)
#   ollama     -> free, local LLM via Ollama (http://localhost:11434)
#   anthropic  -> requires ANTHROPIC_API_KEY
#   openai     -> requires OPENAI_API_KEY
# ---------------------------------------------------------------------------
LLM_PROVIDER=heuristic

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Max rows returned by a single read query preview.
LOCALDB_MAX_PREVIEW_ROWS=200

# ---------------------------------------------------------------------------
# Sandbox preview: every plan is executed against a throwaway in-memory clone
# first, so the preview shows the REAL result, diff and row changes.
# ---------------------------------------------------------------------------
# Skip cloning (fall back to static analysis) above this database size.
LOCALDB_SANDBOX_MAX_MB=200
# Max sample changed rows surfaced from a sandbox preview.
LOCALDB_SANDBOX_SAMPLE_ROWS=10
# Require explicit confirmation for EVERY mutating operation, not just risky ones.
LOCALDB_REQUIRE_CONFIRM_ALL=false

# Logging: debug | info | warn | error
LOG_LEVEL=info
