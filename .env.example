# ---------------------------------------------------------------------------
# LocalDB Agent configuration. Copy to .env and adjust.
# The app works with ZERO configuration using the built-in heuristic planner.
# ---------------------------------------------------------------------------

# Directory where app metadata + snapshots are stored.
LOCALDB_DATA_DIR=./data

# App metadata database. Defaults to $LOCALDB_DATA_DIR/app.db
# APP_DB_PATH=./data/app.db

# Root directory that user .db/.sqlite files may be opened from.
# Path traversal outside this root is rejected. Defaults to ./databases
LOCALDB_DB_ROOT=./databases

# ---------------------------------------------------------------------------
# LLM provider for the planning step.
#   heuristic  -> free, offline, rule-based (default, no key needed)
#   ollama     -> free, local LLM via Ollama (http://localhost:11434)
#   anthropic  -> requires ANTHROPIC_API_KEY
#   openai     -> requires OPENAI_API_KEY
# ---------------------------------------------------------------------------
LLM_PROVIDER=heuristic

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Max rows returned by a single read query preview.
LOCALDB_MAX_PREVIEW_ROWS=200

# ---------------------------------------------------------------------------
# Sandbox preview: every plan is executed against a throwaway in-memory clone
# first, so the preview shows the REAL result, diff and row changes.
# ---------------------------------------------------------------------------
# Skip cloning (fall back to static analysis) above this database size.
LOCALDB_SANDBOX_MAX_MB=200
# Max sample changed rows surfaced from a sandbox preview.
LOCALDB_SANDBOX_SAMPLE_ROWS=10
# Require explicit confirmation for EVERY mutating operation, not just risky ones.
LOCALDB_REQUIRE_CONFIRM_ALL=false

# ---------------------------------------------------------------------------
# Multi-user. Default is single-user (no login) — everything below is optional.
#   AUTH_MODE=single  -> no auth, one shared "local" workspace (default)
#   AUTH_MODE=header  -> identity comes from a trusted reverse-proxy header
#                        (Cloudflare Access, oauth2-proxy, nginx auth_request)
#   AUTH_MODE=oauth   -> built-in GitHub/Google sign-in (Auth.js)
# In header/oauth mode each user gets a private directory under
# $LOCALDB_DB_ROOT/u/<id>/ and can only see/operate their own databases.
# ---------------------------------------------------------------------------
AUTH_MODE=single

# header mode: comma-separated headers to check, first match wins.
# AUTH_HEADER=x-auth-request-email,cf-access-authenticated-user-email

# oauth mode: a random 32+ char secret + at least one provider.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Per-user limits (only enforced in header/oauth mode).
LOCALDB_MAX_DBS_PER_USER=10
LOCALDB_MAX_DB_MB=50
LOCALDB_MAX_USER_MB=200
LOCALDB_AGENT_RATE=30
LOCALDB_AGENT_RATE_WINDOW_S=300

# Logging: debug | info | warn | error
LOG_LEVEL=info
